        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\SQL_Apply_SCD2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="SQL_Apply_SCD2"
          DTS:DTSID="{07AC90A3-C9AF-4D8C-A995-56EC01238D46}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Apply_SCD2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{04067249-EBED-432D-B282-04A3F65FC2E5}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;BEGIN TRAN;&#xA;DECLARE @Now DATETIME = GETDATE();&#xA;&#xA;SELECT EmpID, FirstName, LastName, CAST(FullName AS VARCHAR(100)) AS FullName,&#xA;       Department, Designation, Salary, City, JoiningDate&#xA;INTO #Latest&#xA;FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY EmpID ORDER BY (SELECT NULL)) AS rn&#xA;      FROM dbo.Employee_Stage) x&#xA;WHERE rn = 1;&#xA;&#xA;-- Type 2: expire current rows whose tracked attributes changed&#xA;UPDATE d&#xA;   SET d.ExpiryDate = @Now, d.IsCurrent = 0&#xA;  FROM dbo.Employee_Dim d&#xA;  JOIN #Latest s ON s.EmpID = d.EmpID&#xA; WHERE d.IsCurrent = 1&#xA;   AND EXISTS (SELECT s.FirstName, s.LastName, s.Department, s.Designation, s.Salary, s.City, s.JoiningDate&#xA;               EXCEPT&#xA;               SELECT d.FirstName, d.LastName, d.Department, d.Designation, d.Salary, d.City, d.JoiningDate);&#xA;&#xA;-- Insert new employees and new versions of changed employees&#xA;INSERT INTO dbo.Employee_Dim&#xA;       (EmpID, FirstName, LastName, FullName, Department, Designation, Salary, City, JoiningDate, EffectiveDate, ExpiryDate, IsCurrent)&#xA;SELECT s.EmpID, s.FirstName, s.LastName, s.FullName, s.Department, s.Designation, s.Salary, s.City, s.JoiningDate, @Now, NULL, 1&#xA;  FROM #Latest s&#xA; WHERE NOT EXISTS (SELECT 1 FROM dbo.Employee_Dim d WHERE d.EmpID = s.EmpID AND d.IsCurrent = 1);&#xA;&#xA;TRUNCATE TABLE dbo.Employee_Stage;&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
