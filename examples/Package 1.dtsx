    <DTS:Executable
      DTS:refId="Package\Create_Employee_Dim_Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create_Employee_Dim_Table"
      DTS:DTSID="{35B1236C-23E4-43FF-9700-225491D15854}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create_Employee_Dim_Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{04067249-EBED-432D-B282-04A3F65FC2E5}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Employee_Dim')&#xA;BEGIN&#xA;CREATE TABLE dbo.Employee_Dim (&#xA;    SK_EmployeeID   INT IDENTITY(1,1) PRIMARY KEY,&#xA;    EmpID           INT           NOT NULL,&#xA;    FirstName       VARCHAR(50),&#xA;    LastName        VARCHAR(50),&#xA;    FullName        VARCHAR(100),&#xA;    Department      VARCHAR(50),&#xA;    Designation     VARCHAR(50),&#xA;    Salary          DECIMAL(10,2),&#xA;    City            VARCHAR(50),&#xA;    JoiningDate     DATE,&#xA;    EffectiveDate   DATETIME,&#xA;    ExpiryDate      DATETIME      NULL,&#xA;    IsCurrent       BIT           NOT NULL DEFAULT 1&#xA;);&#xA;END&#xA;&#xA;IF OBJECT_ID('dbo.Employee_Stage') IS NULL&#xA;BEGIN&#xA;CREATE TABLE dbo.Employee_Stage (&#xA;    EmpID           INT           NOT NULL,&#xA;    FirstName       VARCHAR(50),&#xA;    LastName        VARCHAR(50),&#xA;    FullName        NVARCHAR(101),&#xA;    Department      VARCHAR(50),&#xA;    Designation     VARCHAR(50),&#xA;    Salary          DECIMAL(10,2),&#xA;    City            VARCHAR(50),&#xA;    JoiningDate     DATE&#xA;);&#xA;END;&#xA;&#xA;TRUNCATE TABLE dbo.Employee_Stage;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
